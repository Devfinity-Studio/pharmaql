# PharmaQL Environment Variables Configuration Template
# Copy this file to .env and configure for your local/production environment.

# Control Plane Database & Tenant Routing (Neon Serverless Postgres)
CONTROL_PLANE_DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/neondb?sslmode=require"
CONTROL_PLANE_ENCRYPTION_KEY="replace_with_64_character_hex_master_key"
DEV_PORTAL_DOMAIN="pharmaql.devfinity.net"

# API Server Connection (Fallback / Default Client API)
API_SERVER_URL="http://127.0.0.1:9443"
API_SECRET_KEY="replace_with_64_character_hex_secret_key"

# Admin Credentials
ADMIN_EMAIL="asmeepharma2022@gmail.com"
ADMIN_PASSWORD="admin_password_here"
ADMIN_ALLOWED_IPS=""

# Developer Credentials
DEV_EMAIL="dev@asmeepharma.com"
DEV_PASSWORD="dev_password_here"

# Standard Admin Mailer (for MR OTPs & General Admin Alerts)
GMAIL_USER="info.devolvestudio@gmail.com"
GMAIL_PASS="app_password_here"

# Dedicated Developer SMTP Credentials (for License Invoices, System Alerts to Admins/MRs)
# Note: For Zoho Mail in India use smtp.zoho.in (port 465), or smtp.zoho.com globally.
DEV_SMTP_USER="developer@domain.com"
DEV_SMTP_PASS="developer_app_password"
DEV_SMTP_HOST="smtp.zoho.in"
DEV_SMTP_PORT="465"

# Web Push Notification VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
