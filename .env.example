# PharmaQL Multi-Tenant Platform Configuration
# Copy this file to .env and configure for your local or production environment.

# ==============================================================================
# 1. CORE AUTHENTICATION & SESSION
# ==============================================================================
# Stateless JWT signing key (generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET="replace_with_base64_secret"

# ==============================================================================
# 2. MULTI-TENANT CONTROL PLANE (Neon Serverless Postgres)
# ==============================================================================
# Connection string to Neon Postgres database storing tenant registries, isolated configs, & encrypted credentials
CONTROL_PLANE_DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Master AES-256-GCM encryption key for securing tenant API keys, DB connections, & admin passwords
# Must be exactly 32 bytes formatted as 64 hexadecimal characters (generate via `openssl rand -hex 32`)
CONTROL_PLANE_ENCRYPTION_KEY="replace_with_64_character_hex_master_key"

# Canonical hostname of the Master Developer Control Center (e.g. pharmaql.devfinity.net or localhost:3000)
DEV_PORTAL_DOMAIN="pharmaql.devfinity.net"

# ==============================================================================
# 3. PLATFORM DEVELOPER CREDENTIALS & ALERTS
# ==============================================================================
DEV_EMAIL="dev@devfinity.net"
DEV_PASSWORD="replace_with_secure_developer_password"

# Dedicated Developer SMTP (Zoho Mail / Resend / SendGrid / Custom SMTP)
# Used for system notifications, billing invoices, and tenant lifecycle alerts
DEV_SMTP_USER="info@devfinity.net"
DEV_SMTP_PASS="replace_with_developer_smtp_app_password"
DEV_SMTP_HOST="smtp.zoho.in"
DEV_SMTP_PORT="465"

# ==============================================================================
# 4. OPTIONAL FALLBACKS (Local Offline Single-Tenant Development Only)
# ==============================================================================
# When running completely offline without Neon Postgres, these fallbacks emulate a single tenant:
ADMIN_EMAIL="admin@asmeepharma.com"
ADMIN_PASSWORD="replace_with_admin_password"
API_SERVER_URL="http://127.0.0.1:9443"
API_SECRET_KEY="replace_with_64_character_hex_secret_key"
GMAIL_USER="fallback.mailer@gmail.com"
GMAIL_PASS="fallback_app_password"

# ==============================================================================
# 5. WEB PUSH NOTIFICATIONS (Optional)
# ==============================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
